#!/usr/bin/env zsh
# ISA (Intelligent Support Assistant) Shell Configuration
# Universal configuration - works on macOS and Linux
# Compatible with: zsh, bash
# Source this file from your .zshrc or .bashrc
# Location: ~/projects/isa/isa.rc
# Last Updated: 2025-10-18

# ============================================================================
# ISA LOADING STATUS
# ============================================================================

# Show loading status (only when manually sourced, not from .zshrc)
_ISA_LOADING_START=$(date +%s%N 2>/dev/null || date +%s)

# ============================================================================
# OS DETECTION
# ============================================================================

# Detect operating system
if [[ -z "${ISA_OS}" ]]; then
    case "$(uname -s)" in
        Darwin*)
            export ISA_OS="macos"
            ;;
        Linux*)
            export ISA_OS="linux"
            ;;
        *)
            export ISA_OS="unknown"
            ;;
    esac
fi

# ============================================================================
# ISA ENVIRONMENT SETUP
# ============================================================================

# ISA tool/codebase location
export ISA_ROOT="${HOME}/projects/isa"

# User config/data location
export ISA_CONFIG="${HOME}/.config/isa"
export ISA_CONTEXTS="${ISA_CONFIG}/contexts"
export ISA_BIN="${HOME}/.local/bin"

# Ensure ISA directories exist
[[ ! -d "${ISA_ROOT}" ]] && mkdir -p "${ISA_ROOT}"
[[ ! -d "${ISA_CONFIG}" ]] && mkdir -p "${ISA_CONFIG}"
[[ ! -d "${ISA_CONTEXTS}" ]] && mkdir -p "${ISA_CONTEXTS}"
[[ ! -d "${ISA_BIN}" ]] && mkdir -p "${ISA_BIN}"

# Service Configuration - can be overridden in ~/.config/isa/config
export ISA_OLLAMA_HOST="${ISA_OLLAMA_HOST:-192.168.1.161}"
export ISA_OLLAMA_PORT="${ISA_OLLAMA_PORT:-11434}"
export ISA_VECTOR_HOST="${ISA_VECTOR_HOST:-192.168.1.161}"
export ISA_VECTOR_PORT="${ISA_VECTOR_PORT:-8000}"
export ISA_MODELS_DEV_API="${ISA_MODELS_DEV_API:-https://api.models.dev/v1}"

# Derived URLs for convenience
export ISA_OLLAMA_URL="http://${ISA_OLLAMA_HOST}:${ISA_OLLAMA_PORT}"
export ISA_VECTOR_URL="http://${ISA_VECTOR_HOST}:${ISA_VECTOR_PORT}"

# ============================================================================
# ISA CORE ALIASES
# ============================================================================

# Context Management with bat integration for colorized markdown
alias isa-load='${ISA_ROOT}/load-context.sh'
alias isa-me='isa-show-markdown ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias isa-index='isa-show-markdown ${ISA_CONTEXTS}/people/ahmed-masud/INDEX.md'
alias isa-urgent='echo "🔥 URGENT PRIORITIES:"; grep -A 30 "URGENT PRIORITIES" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias isa-week='echo "📅 THIS WEEK:"; grep -A 20 "This Week" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias isa-matrix='echo "📊 PRIORITY MATRIX:"; grep -A 10 "PRIORITY MATRIX" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias isa-todo='isa-show-markdown ${ISA_ROOT}/TODO.md'
alias isa-roadmap='isa-show-markdown ${ISA_ROOT}/ROADMAP.md'
alias isa-help='isa-show-markdown ${ISA_ROOT}/QUICK-START.md'

# Quick edits
alias isa-edit-priorities='${EDITOR:-vim} ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias isa-edit-todo='${EDITOR:-vim} ${ISA_ROOT}/TODO.md'
alias isa-edit-context='${EDITOR:-vim} ${ISA_CONTEXTS}/people/ahmed-masud/README.md'

# Navigation
alias cdisa='cd ${ISA_ROOT}'          # Go to ISA tool code
alias cdconfig='cd ${ISA_CONFIG}'     # Go to ISA config
alias cdme='cd ${ISA_CONTEXTS}/people/ahmed-masud'
alias cdcontexts='cd ${ISA_CONTEXTS}'

# Project navigation (from priorities)
alias cdchatgpt='cd ${HOME}/projects/ahmed-masud'
alias cdresiliate='cd ${ISA_CONFIG}/resiliate-backend'

# ============================================================================
# ISA FUNCTIONS
# ============================================================================

# Main ISA command function
isa() {
    local cmd="${1:-help}"
    shift
    
    case "${cmd}" in
        load|ctx-switch)
            ${ISA_ROOT}/load-context.sh "$@"
            ;;
        me|my|self)
            isa-show-markdown ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md
            ;;
        urgent)
            grep -A 40 "URGENT PRIORITIES" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md
            ;;
        week|weekly)
            echo "=== This Week's Tasks ==="
            grep -A 20 "This Week" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md
            ;;
        month|monthly)
            echo "=== Next Month's Plan ==="
            grep -A 15 "Next Month" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md
            ;;
        todo|todos)
            isa-show-markdown ${ISA_ROOT}/TODO.md
            ;;
        edit)
            ${EDITOR:-vim} ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md
            ;;
	      show)
            # Enhanced show command with intelligent context parsing
            local show_args="$*"
            
            if [[ -z "$show_args" ]]; then
                echo "🤔 What would you like me to show?"
                echo ""
                echo "📋 Personal & Tasks:"
                echo "  isa show priorities    # Your personal priorities"
                echo "  isa show urgent       # Urgent items"
                echo "  isa show week         # This week's tasks"
                echo "  isa show todo         # Todo items"
                echo ""
                echo "🔧 Context & System:"
                echo "  isa show contexts     # Available contexts"
                echo "  isa show config       # System configuration" 
                echo "  isa show status       # System status"
		echo "  isa show services     # AI & Database services"
                return 0
            fi
            
            local args_lower=$(echo "$show_args" | tr '[:upper:]' '[:lower:]')
            case "$args_lower" in
                priorities|priority)
                    isa me
                    ;;
                urgent)
                    isa urgent
                    ;;
                week|weekly)
                    isa week
                    ;;
                todo|todos)
                    isa todo
                    ;;
                contexts)
                    isa contexts
                    ;;
                config|configuration)
                    echo "🔧 ISA Configuration:"
                    echo "ISA_ROOT: ${ISA_ROOT}"
                    echo "ISA_CONFIG: ${ISA_CONFIG}" 
                    echo "ISA_CONTEXTS: ${ISA_CONTEXTS}"
                    ;;
                status|health)
                    echo "📊 ISA System Status"
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    echo "🏠 Environment:"
                    echo "  ISA Root: ${ISA_ROOT}"
                    echo "  Current Directory: $(pwd)"
                    echo ""
                    
                    echo "🤖 AI Services:"
                    # Check Ollama server
                    if command -v nc >/dev/null 2>&1; then
                        if nc -z -w3 ${ISA_OLLAMA_HOST} ${ISA_OLLAMA_PORT} 2>/dev/null; then
                            echo "  ✅ Ollama Server (${ISA_OLLAMA_HOST}:${ISA_OLLAMA_PORT})"
                        else
                            echo "  ❌ Ollama Server (${ISA_OLLAMA_HOST}:${ISA_OLLAMA_PORT}) - Not reachable"
                        fi
                    else
                        echo "  ❓ Ollama Server (${ISA_OLLAMA_HOST}:${ISA_OLLAMA_PORT}) - Cannot check"
                    fi
                    
                    # Check Models.dev (external)
                    echo "  🌐 Models.dev API (https://api.models.dev/v1) - External service"
                    
                    echo ""
                    echo "🗂️  Vector Database:"
                    # Check vector service
                    if command -v nc >/dev/null 2>&1; then
                        if nc -z -w3 ${ISA_VECTOR_HOST} ${ISA_VECTOR_PORT} 2>/dev/null; then
                            echo "  ✅ Vector Service (${ISA_VECTOR_HOST}:${ISA_VECTOR_PORT})"
                        else
                            echo "  ❌ Vector Service (${ISA_VECTOR_HOST}:${ISA_VECTOR_PORT}) - Not reachable"
                        fi
                    else
                        echo "  ❓ Vector Service (${ISA_VECTOR_HOST}:${ISA_VECTOR_PORT}) - Cannot check"
                    fi
                    
                    echo ""
                    echo "🔧 System Tools:"
                    if command -v python3 >/dev/null; then
                        echo "  ✅ Python3 available"
                    else
                        echo "  ❌ Python3 not found"
                    fi
                    
                    if [[ -f "${ISA_ROOT}/tools/command_intent.py" ]]; then
                        echo "  ✅ Command intent system available"
                    else
                        echo "  ❌ Command intent system missing"
                    fi
                    
                    if command -v nc >/dev/null; then
                        echo "  ✅ Network connectivity check (nc) available"
                    else
                        echo "  ⚠️  Network connectivity check (nc) not available"
                    fi
                    ;;
         	services)
                    echo "🚀 ISA Service Status"
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    echo ""
                    echo "🤖 AI Services:"
                    # Check Ollama server
                    if command -v nc >/dev/null 2>&1; then
                        if nc -z -w3 ${ISA_OLLAMA_HOST} ${ISA_OLLAMA_PORT} 2>/dev/null; then
                            echo "  ✅ Ollama Server (${ISA_OLLAMA_HOST}:${ISA_OLLAMA_PORT})"
                        else
                            echo "  ❌ Ollama Server (${ISA_OLLAMA_HOST}:${ISA_OLLAMA_PORT}) - Not reachable"
                        fi
                    else
                        echo "  ❓ Ollama Server (${ISA_OLLAMA_HOST}:${ISA_OLLAMA_PORT}) - Cannot check"
                    fi
                    
                    echo "  🌐 Models.dev API (https://api.models.dev/v1) - External service"
                    echo ""
                    
                    echo "🗂️  Vector Database:"
                    # Check vector service
                    if command -v nc >/dev/null 2>&1; then
                        if nc -z -w3 ${ISA_VECTOR_HOST} ${ISA_VECTOR_PORT} 2>/dev/null; then
                            echo "  ✅ Vector Service (${ISA_VECTOR_HOST}:${ISA_VECTOR_PORT})"
                        else
                            echo "  ❌ Vector Service (${ISA_VECTOR_HOST}:${ISA_VECTOR_PORT}) - Not reachable"
                        fi
                    else
                        echo "  ❓ Vector Service (${ISA_VECTOR_HOST}:${ISA_VECTOR_PORT}) - Cannot check"
                    fi
                    ;;
                *)
                    echo "🤔 Not sure what to show: '$show_args'"
                    echo "Try: priorities, urgent, week, todo, contexts, config, status"
                    return 1
                    ;;
            esac
            ;;
        contexts|list)
            # Read current context
            local current_context=""
            if [[ -f "${ISA_CONFIG}/.current_context" ]]; then
                current_context=$(cat "${ISA_CONFIG}/.current_context" 2>/dev/null | tr -d '\0\n\r')
            fi
            
            echo "Available contexts:"
            if [[ -n "${current_context}" ]]; then
                echo "🎯 Current: ${current_context}"
            fi
            echo ""
            for type in people places things; do
                if [[ -d "${ISA_CONTEXTS}/${type}" ]]; then
                    echo "📂 ${type}:"
                    # List contexts with current context indicator
                    if command -v exa >/dev/null 2>&1; then
                        for ctx in "${ISA_CONTEXTS}/${type}"/*; do
	    		    [[ -d "$ctx" ]] || continue
                            local ctx_name=$(basename "$ctx")
                            if [[ "${ctx_name}" = "${current_context}" ]]; then
                                echo "  ➤ ${ctx_name} 🎯 (current)"
                            else
                                echo "  - ${ctx_name}"
                            fi
                            # Handle symlinks
                            if [[ -L "$ctx" ]]; then
                                local link_target=$(readlink "$ctx")
                                echo "    └─ → ${link_target}"
                            fi
                        done
                    else
                        # Fallback for systems without exa
                        for ctx in "${ISA_CONTEXTS}/${type}"/*; do
                            if [[ -d "$ctx" ]]; then
                                local ctx_name=$(basename "$ctx")
                                if [[ "${ctx_name}" = "${current_context}" ]]; then
                                    echo "  ➤ ${ctx_name} 🎯 (current)"
                                else
                                    echo "  - ${ctx_name}"
                                fi
                                # Handle symlinks
                                if [[ -L "${ctx%/}" ]]; then
                                    local link_target=$(readlink "${ctx%/}")
                                    echo "    └─ → ${link_target}"
                                fi
                            fi
                        done
                    fi
                fi
            done
            
            # List sub-contexts
            local sub_contexts_dir="${ISA_CONFIG}/sub-contexts"
            if [[ -d "${sub_contexts_dir}" ]] && [[ $(find "${sub_contexts_dir}" -maxdepth 1 -type d | wc -l) -gt 1 ]]; then
                echo "📂 sub-contexts:"
                for sub_ctx in ${sub_contexts_dir}/*/; do
                    if [[ -d "$sub_ctx" ]]; then
                        local sub_ctx_name=$(basename "$sub_ctx")
                        if [[ "${sub_ctx_name}" = "${current_context}" ]]; then
                            echo "  ➤ ${sub_ctx_name} 🎯 (current)"
                        else
                            echo "  - ${sub_ctx_name}"
                        fi
                        
                        # Show parent info for sub-contexts
                        local info_file="${sub_ctx}/.sub-context-info.json"
                        if [[ -f "${info_file}" ]]; then
                            local parents=$(python3 -c "import json; data=json.load(open('${info_file}')); print(' + '.join([p['name'] for p in data.get('parent_contexts', [])]))" 2>/dev/null) 
                            if [[ -n "${parents}" ]]; then
                                echo "    └─ 🎨 blended from: ${parents}"
                            fi
                        fi
                    fi
                done
            fi
            ;;
        status)
            echo "╔════════════════════════════════════════════════════════╗"
            echo "║              ISA Status Dashboard                      ║"
            echo "╚════════════════════════════════════════════════════════╝"
            echo ""
            echo "📍 Location: ${ISA_ROOT}"
            echo "👤 Context: Ahmed Masud"
            echo ""
            echo "🔥 Urgent Items:"
            grep -A 5 "Status.*NOT STARTED\|Status.*IN PROGRESS" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null | head -10
            echo ""
            echo "📊 Priority Matrix:"
            grep -A 6 "Priority Matrix" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null | tail -5
            ;;
        search)
            if [[ -z "$1" ]]; then
                echo "Usage: isa search <query>"
                return 1
            fi
            echo "🔍 Searching contexts for: $@"
            grep -r "$@" ${ISA_CONTEXTS}/ 2>/dev/null
            ;;
        update)
            echo "🔄 Updating ISA system..."
            cd ${ISA_ROOT}
            if [[ -d .git ]]; then
                git pull
                echo "✅ ISA updated successfully"
            else
                echo "⚠️  No git repository found. Manual update required."
            fi
            ;;
        ask)
            if command -v isa_ai_ask >/dev/null 2>&1; then
                isa_ai_ask "$@"
            else
                echo "❌ AI integration not available. Load ollama-client module first."
            fi
            ;;
        ai-analyze|analyze)
            if command -v isa_ai_analyze >/dev/null 2>&1; then
                isa_ai_analyze "$@"
            else
                echo "❌ AI integration not available. Load ollama-client module first."
            fi
            ;;
        suggest)
            if command -v isa_ai_suggest >/dev/null 2>&1; then
                isa_ai_suggest "$@"
            else
                echo "❌ AI integration not available. Load ollama-client module first."
            fi
            ;;
        ai-status)
            if command -v isa_ai_status >/dev/null 2>&1; then
                isa_ai_status
            else
                echo "❌ AI integration not available. Load ollama-client module first."
            fi
            ;;
        context-sync|ctx-sync)
            echo "🔄 Processing contexts into vector database..."
            local count=0
            
            # Process regular contexts
            for file in $(find ${ISA_CONTEXTS} -name "*.md" -type f); do
                echo "  Processing: ${file##*/}"
                python3 ${ISA_ROOT}/tools/chunk_and_embed.py "$file" 2>/dev/null && ((count++))
            done
            
            # Process sub-contexts
            local sub_contexts_dir="${ISA_CONFIG}/sub-contexts"
            if [[ -d "${sub_contexts_dir}" ]]; then
                echo "🎨 Processing blended contexts..."
                for file in $(find "${sub_contexts_dir}" -name "*.md" -type f); do
                    echo "  Processing blended: ${file##*/}"
                    python3 ${ISA_ROOT}/tools/chunk_and_embed.py "$file" 2>/dev/null && ((count++))
                done
            fi
            
            echo "✅ Processed $count context files (including blended contexts)"
            ;;
        context-stats|ctx-stats)
            echo "📊 Vector Database Statistics"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            curl -s http://${ISA_VECTOR_HOST}:${ISA_VECTOR_PORT}/stats 2>/dev/null | python3 -c "import json, sys; data=json.load(sys.stdin); print(f'  Total Chunks: {data.get(\"total_chunks\", 0)}\n  Trained: {data.get(\"is_trained\", False)}\n  Storage: {data.get(\"storage_dir\", \"unknown\")}')" || echo "  ❌ Vector service not available"
            ;;
        context-search|ctx-search)
            if [[ -z "$1" ]]; then
                echo "Usage: isa context-search <query>"
                echo "Example: isa context-search 'deployment procedures'"
                return 1
            fi
            # Join all arguments into a single quoted query
            local query="$*"
            echo "🔍 Semantic Search: $query"
            echo ""
            python3 ${ISA_ROOT}/tools/semantic_context.py "$query" --format text
            ;;
        context-rebuild|ctx-rebuild)
            echo "🔨 Rebuilding vector database index..."
            curl -s -X POST http://${ISA_VECTOR_HOST}:${ISA_VECTOR_PORT}/rebuild 2>/dev/null | python3 -c "import json, sys; data=json.load(sys.stdin); print(f'✅ Rebuilt: {data.get(\"total_chunks\", 0)} chunks')" || echo "❌ Rebuild failed"
            ;;
        context-health|ctx-health)
            echo "🏥 Checking semantic context services..."
            echo ""
            
            # Check vector database
            echo "Vector Database (${ISA_VECTOR_HOST}:${ISA_VECTOR_PORT}):"
            if curl -s http://${ISA_VECTOR_HOST}:${ISA_VECTOR_PORT}/health 2>/dev/null | grep -q "healthy"; then
                echo "  ✅ Healthy"
            else
                echo "  ❌ Unavailable"
            fi
            
            # Check Ollama
            echo ""
            echo "Ollama AI (${ISA_OLLAMA_HOST}:${ISA_OLLAMA_PORT}):"
            if curl -s http://${ISA_OLLAMA_HOST}:${ISA_OLLAMA_PORT}/api/tags 2>/dev/null | grep -q "models"; then
                echo "  ✅ Healthy"
            else
                echo "  ❌ Unavailable"
            fi
            
            # Check context watcher
            echo ""
            echo "Context Watcher (local):"
            if ps aux | grep -v grep | grep -q "context_watcher.py"; then
                echo "  ✅ Running"
            else
                echo "  ⚠️  Not running"
            fi
            ;;
        context-add|ctx-add)
            if [[ -z "$1" ]]; then
                echo "Usage: isa context-add <markdown-file>"
                return 1
            fi
            if [[ ! -f "$1" ]]; then
                echo "❌ File not found: $1"
                return 1
            fi
            echo "📝 Adding context to vector database..."
            python3 ${ISA_ROOT}/tools/chunk_and_embed.py "$1" 2>/dev/null && echo "✅ Context added successfully" || echo "❌ Failed to add context"
            ;;
        learn)
            # Get current context
            local current_context=""
            if [[ -f "${ISA_CONFIG}/.current_context" ]]; then
                current_context=$(cat "${ISA_CONFIG}/.current_context" 2>/dev/null | tr -d '\0\n\r')
            fi
            
            if [[ -z "${current_context}" ]]; then
                echo "❌ No current context set. Use 'isa load <context>' or 'isa push <context>' first."
                return 1
            fi
            
            # Find context directory
            local context_dir=""
            for type in people places things; do
                if [[ -d "${ISA_CONTEXTS}/${type}/${current_context}" ]]; then
                    context_dir="${ISA_CONTEXTS}/${type}/${current_context}"
                    break
                fi
            done
            
            # Check sub-contexts too
            if [[ -z "${context_dir}" ]] && [[ -d "${ISA_CONFIG}/sub-contexts/${current_context}" ]]; then
                context_dir="${ISA_CONFIG}/sub-contexts/${current_context}"
            fi
            
            if [[ -z "${context_dir}" ]]; then
                echo "❌ Context directory not found for: ${current_context}"
                return 1
            fi
            
            if [[ -z "$1" ]]; then
                echo "Usage: isa learn <file-or-text>"
                echo "Examples:"
                echo "  isa learn /path/to/document.pdf     # Learn from PDF"
                echo "  isa learn /path/to/report.docx      # Learn from Word document"
                echo "  isa learn /path/to/data.xlsx        # Learn from Excel spreadsheet"
                echo "  isa learn /path/to/slides.pptx      # Learn from PowerPoint"
                echo "  isa learn /path/to/notes.md         # Learn from Markdown"
                echo "  isa learn /path/to/config.json      # Learn from JSON/YAML/XML"
                echo "  isa learn 'Important note content'  # Create note from text"
                echo ""
                echo "Supported formats: PDF, DOCX, XLSX, PPTX, ODT, RTF, TXT, MD, HTML, CSV, JSON, XML, YAML"
                return 1
            fi
            
            # Check if it's a file
            if [[ -f "$1" ]]; then
                local source_file="$1"
                local filename=$(basename "$1")
                
                echo "📚 Learning from file: $1"
                echo "📍 Context: ${current_context}"
                
                # Use universal document processor to handle any file type
                echo "🔍 Processing document..."
                local processed_file=$(python3 ${ISA_ROOT}/tools/universal_document_processor.py "${source_file}" --context "${context_dir}" 2>&1)
                local processor_exit_code=$?
                
                if [[ $processor_exit_code -eq 0 ]]; then
                    # Extract the markdown file path from the output
                    local markdown_file=$(echo "${processed_file}" | grep "Successfully processed:" | sed 's/.*Successfully processed: //')
                    
                    if [[ -n "${markdown_file}" && -f "${markdown_file}" ]]; then
                        echo "✅ Document processed and converted to markdown"
                        
                        # Add to vector database
                        echo "📊 Adding to vector database..."
                        python3 ${ISA_ROOT}/tools/chunk_and_embed.py "${markdown_file}" 2>/dev/null && \
                            echo "✅ Successfully learned from ${filename}" || \
                            echo "⚠️  Document processed but failed to add to vector database"
                    else
                        echo "⚠️  Document processed but could not find output file"
                        echo "${processed_file}"
                    fi
                else
                    echo "❌ Failed to process document:"
                    echo "${processed_file}"
                    
                    # Fallback: try the old method for markdown files
                    if [[ "${source_file}" =~ \.(md|txt)$ ]]; then
                        echo "🔄 Falling back to direct copy for text/markdown file..."
                        local dest_file="${context_dir}/${filename}"
                        cp "${source_file}" "${dest_file}" && \
                            python3 ${ISA_ROOT}/tools/chunk_and_embed.py "${dest_file}" 2>/dev/null && \
                            echo "✅ Successfully learned from ${filename} (fallback method)" || \
                            echo "❌ Fallback method also failed"
                    else
                        return 1
                    fi
                fi
            else
                # Treat as text content
                local timestamp=$(date '+%Y%m%d-%H%M%S')
                local note_file="${context_dir}/note-${timestamp}.md"
                local content="$*"
                
                echo "📝 Creating note in context: ${current_context}"
                
                # Create note file with content
                cat > "${note_file}" << EOF
# Note - $(date '+%Y-%m-%d %H:%M:%S')

${content}

---
*Created by ISA learn command*
EOF
                
                echo "✅ Created: $(basename "${note_file}")"
                
                # Add to vector database
                echo "📊 Adding to vector database..."
                python3 ${ISA_ROOT}/tools/chunk_and_embed.py "${note_file}" 2>/dev/null && \
                    echo "✅ Successfully learned note" || \
                    echo "⚠️  Note created but failed to add to vector database"
            fi
            ;;
        unlearn)
            # Get current context
            local current_context=""
            if [[ -f "${ISA_CONFIG}/.current_context" ]]; then
                current_context=$(cat "${ISA_CONFIG}/.current_context" 2>/dev/null | tr -d '\0\n\r')
            fi
            
            if [[ -z "${current_context}" ]]; then
                echo "❌ No current context set. Use 'isa load <context>' or 'isa push <context>' first."
                return 1
            fi
            
            # Find context directory
            local context_dir=""
            for type in people places things; do
                if [[ -d "${ISA_CONTEXTS}/${type}/${current_context}" ]]; then
                    context_dir="${ISA_CONTEXTS}/${type}/${current_context}"
                    break
                fi
            done
            
            # Check sub-contexts too
            if [[ -z "${context_dir}" ]] && [[ -d "${ISA_CONFIG}/sub-contexts/${current_context}" ]]; then
                context_dir="${ISA_CONFIG}/sub-contexts/${current_context}"
            fi
            
            if [[ -z "${context_dir}" ]]; then
                echo "❌ Context directory not found for: ${current_context}"
                return 1
            fi
            
            if [[ -z "$1" ]]; then
                echo "Usage: isa unlearn <filename>"
                echo "Example: isa unlearn note-20251018-012345.md"
                echo ""
                echo "📂 Files in current context (${current_context}):"
                ls -1 "${context_dir}"/*.md 2>/dev/null | while read file; do
                    echo "  - $(basename "$file")"
                done
                return 1
            fi
            
            local filename="$1"
            local file_path="${context_dir}/${filename}"
            
            # Handle both with and without .md extension
            if [[ ! -f "${file_path}" ]] && [[ -f "${file_path}.md" ]]; then
                file_path="${file_path}.md"
                filename="${filename}.md"
            fi
            
            if [[ ! -f "${file_path}" ]]; then
                echo "❌ File not found in context: ${filename}"
                echo ""
                echo "📂 Available files:"
                ls -1 "${context_dir}"/*.md 2>/dev/null | while read file; do
                    echo "  - $(basename "$file")"
                done
                return 1
            fi
            
            # Protect core files
            case "${filename}" in
                README.md|PRIORITIES.md|INDEX.md)
                    echo "⚠️  Warning: '${filename}' is a core context file."
                    echo -n "Are you sure you want to remove it? [y/N] "
                    read -r confirm
                    if [[ "${confirm}" != "y" ]] && [[ "${confirm}" != "Y" ]]; then
                        echo "❌ Cancelled"
                        return 1
                    fi
                    ;;
            esac
            
            echo "🗑️  Removing: ${filename}"
            echo "📍 Context: ${current_context}"
            
            # Remove the file
            rm "${file_path}" && \
                echo "✅ Removed ${filename}" || {
                echo "❌ Failed to remove file"
                return 1
            }
            
            # Rebuild vector database to remove the content
            echo "🔄 Rebuilding vector database to remove learned content..."
            curl -s -X POST http://${ISA_VECTOR_HOST}:${ISA_VECTOR_PORT}/rebuild 2>/dev/null >/dev/null
            echo "📊 Re-syncing contexts..."
            isa context-sync >/dev/null 2>&1
            echo "✅ Successfully unlearned ${filename}"
            ;;
        push|context-push)
            if [[ -z "$1" ]]; then
                echo "Usage: isa push <context-name>"
                echo "Example: isa push ahmed-masud"
                return 1
            fi
            # Set current context for tracking
            if [[ -n "$ISA_CURRENT_CONTEXT" ]]; then
                echo "$ISA_CURRENT_CONTEXT" > ${ISA_CONFIG}/.current_context
            fi
            # Execute push operation
            python3 ${ISA_ROOT}/tools/context_stack.py push "$1"
            local exit_code=$?
            if [[ $exit_code -eq 0 ]]; then
                export ISA_CURRENT_CONTEXT="$1"
            fi
            return $exit_code
            ;;
        pop|context-pop)
            # Execute pop operation
            python3 ${ISA_ROOT}/tools/context_stack.py pop
            local exit_code=$?
            if [[ $exit_code -eq 0 ]] && [[ -f ${ISA_CONFIG}/.current_context ]]; then
                export ISA_CURRENT_CONTEXT=$(cat ${ISA_CONFIG}/.current_context)
            fi
            return $exit_code
            ;;
        stack|context-stack)
            python3 ${ISA_ROOT}/tools/context_stack.py stack
            ;;
        peek|context-peek)
            python3 ${ISA_ROOT}/tools/context_stack.py peek
            ;;
        breadcrumbs|context-breadcrumbs)
            python3 ${ISA_ROOT}/tools/context_stack.py breadcrumbs
            ;;
        stack-clear|context-clear)
            python3 ${ISA_ROOT}/tools/context_stack.py clear
            ;;
        stack-history|context-history)
            python3 ${ISA_ROOT}/tools/context_stack.py history "$@"
            ;;
        drive-mount|gdrive-mount|mount-drive)
            if [[ -z "$1" ]]; then
                # Auto-mount for current context
                python3 ${ISA_ROOT}/tools/google_drive_integration.py auto-mount
            else
                # Mount specific context
                python3 ${ISA_ROOT}/tools/google_drive_integration.py mount "$1"
            fi
            ;;
        drive-unmount|gdrive-unmount|unmount-drive)
            if [[ -z "$1" ]]; then
                # Unmount current context
                python3 ${ISA_ROOT}/tools/google_drive_integration.py unmount
            else
                # Unmount specific context
                python3 ${ISA_ROOT}/tools/google_drive_integration.py unmount "$1"
            fi
            ;;
        drive-status|gdrive-status)
            python3 ${ISA_ROOT}/tools/google_drive_integration.py status
            ;;
        drive-list|gdrive-list|list-drives)
            python3 ${ISA_ROOT}/tools/google_drive_integration.py list
            ;;
        drive-setup|gdrive-setup)
            if [[ -z "$1" ]]; then
                echo "Usage: isa drive-setup <context-name>"
                echo "Example: isa drive-setup ahmed-masud"
                return 1
            fi
            python3 ${ISA_ROOT}/tools/google_drive_integration.py setup "$1"
            ;;
        sub-create|subcreate)
            if [[ -z "$2" ]]; then
                echo "Usage: isa sub-create <sub-name> <parent1> [parent2 ...] [--description='text']"
                echo "Examples:"
                echo "  isa sub-create resiliate-v2 resiliate                   # Single parent"
                echo "  isa sub-create mixed-project resiliate cybernetic-engram  # Multiple parents"
                echo "  isa sub-create test ahmed-masud resiliate --description='Test blend'"
                return 1
            fi
            # Parse arguments to separate parents from description
            local sub_name="$1"
            shift
            local parents=()
            local description=""
            
            # Collect all arguments that aren't the description flag
            while [[ $# -gt 0 ]]; do
                case $1 in
                    --description=*)
                        description="${1#--description=}"
                        shift
                        ;;
                    --description)
                        shift
                        description="$1"
                        shift
                        ;;
                    *)
                        parents+=("$1")
                        shift
                        ;;
                esac
            done
            
            # Build the command
            local cmd_args=(create "$sub_name")
            cmd_args+=("${parents[@]}")
            if [[ -n "$description" ]]; then
                cmd_args+=(--description="$description")
            fi
            
            python3 ${ISA_ROOT}/tools/sub_context_manager.py "${cmd_args[@]}"
            ;;
        sub-list|sublist)
            python3 ${ISA_ROOT}/tools/sub_context_manager.py list
            ;;
        sub-info|subinfo)
            if [[ -z "$1" ]]; then
                echo "Usage: isa sub-info <sub-context-name>"
                return 1
            fi
            python3 ${ISA_ROOT}/tools/sub_context_manager.py info "$1"
            ;;
        sub-delete|subdelete)
            if [[ -z "$1" ]]; then
                echo "Usage: isa sub-delete <sub-context-name> [--force]"
                return 1
            fi
            python3 ${ISA_ROOT}/tools/sub_context_manager.py delete "$@"
            ;;
        sub-sync|subsync)
            if [[ -z "$1" ]]; then
                echo "Usage: isa sub-sync <sub-context-name>"
                return 1
            fi
            python3 ${ISA_ROOT}/tools/sub_context_manager.py sync "$1"
            ;;
        sub-cleanup|subcleanup)
            python3 ${ISA_ROOT}/tools/sub_context_manager.py cleanup
            ;;
        new|create)
            if [[ -z "$1" ]]; then
                echo "Usage: isa new <context-name> [type] [--switch]"
                echo "Types: people, places, things (default: people)"
                echo "Examples:"
                echo "  isa new john-doe                    # Create person context"
                echo "  isa new aws-prod places             # Create place context"
                echo "  isa new kubernetes-cluster things   # Create thing context"
                echo "  isa new project-x --switch          # Create and switch to context"
                return 1
            fi
            
            local context_name="$1"
            local context_type="people"
            local should_switch=false
            shift
            
            # Parse remaining arguments
            while [[ $# -gt 0 ]]; do
                case $1 in
                    people|places|things)
                        context_type="$1"
                        shift
                        ;;
                    --switch|-s)
                        should_switch=true
                        shift
                        ;;
                    *)
                        echo "Unknown argument: $1"
                        return 1
                        ;;
                esac
            done
            
            # Create the context directory
            local context_dir="${ISA_CONTEXTS}/${context_type}/${context_name}"
            
            if [[ -d "${context_dir}" ]]; then
                echo "❌ Context '${context_name}' already exists in ${context_type}"
                return 1
            fi
            
            echo "🆕 Creating new context: ${context_name} (type: ${context_type})"
            mkdir -p "${context_dir}"
            
            # Create README.md template
            cat > "${context_dir}/README.md" << EOF
# ${context_name}

## Overview

Context for ${context_name}.

## Key Information

- **Type**: ${context_type}
- **Created**: $(date '+%Y-%m-%d')
- **Status**: Active

## Notes

(Add your notes here)

## Resources

(Add relevant links, documents, or references)

## Action Items

- [ ] Initialize context documentation
- [ ] Add relevant information
- [ ] Set up any necessary integrations

---
*Context created by ISA on $(date '+%Y-%m-%d %H:%M:%S')*
EOF
            
            # For people contexts, also create PRIORITIES.md
            if [[ "${context_type}" == "people" ]]; then
                cat > "${context_dir}/PRIORITIES.md" << EOF
# ${context_name} - Priorities

## Current Focus

### URGENT PRIORITIES (Next 5 days)

1. **[Task Name]**
   - Status: NOT STARTED
   - Deadline: [Date]
   - Impact: High
   - Notes: [Description]

### This Week

- [ ] [Task 1]
- [ ] [Task 2]
- [ ] [Task 3]

### Next Month

- [ ] [Future task 1]
- [ ] [Future task 2]

## PRIORITY MATRIX

### High Impact, High Urgency (Do First)
- [Item]

### High Impact, Low Urgency (Schedule)
- [Item]

### Low Impact, High Urgency (Delegate)
- [Item]

### Low Impact, Low Urgency (Eliminate)
- [Item]

---
*Last Updated: $(date '+%Y-%m-%d')*
EOF
            fi
            
            echo "✅ Created context structure in ${context_dir}"
            echo "📝 Files created:"
            echo "  - README.md"
            if [[ "${context_type}" == "people" ]]; then
                echo "  - PRIORITIES.md"
            fi
            
            # Add to vector database
            echo "📊 Adding to vector database..."
            python3 ${ISA_ROOT}/tools/chunk_and_embed.py "${context_dir}/README.md" 2>/dev/null && echo "✅ Added README.md to vector database" || echo "⚠️  Could not add to vector database"
            if [[ -f "${context_dir}/PRIORITIES.md" ]]; then
                python3 ${ISA_ROOT}/tools/chunk_and_embed.py "${context_dir}/PRIORITIES.md" 2>/dev/null && echo "✅ Added PRIORITIES.md to vector database" || echo "⚠️  Could not add PRIORITIES.md to vector database"
            fi
            
            # Switch to context if requested
            if [[ "${should_switch}" == "true" ]]; then
                echo "🔄 Switching to context: ${context_name}"
                export ISA_CURRENT_CONTEXT="${context_name}"
                echo "${context_name}" > "${ISA_CONFIG}/.current_context"
                echo "🎯 Current context: ${context_name}"
            fi
            
            echo ""
            echo "💡 Next steps:"
            echo "  isa edit     # Edit the new context files"
            if [[ "${should_switch}" != "true" ]]; then
                echo "  isa push ${context_name}    # Switch to this context"
            fi
            echo "  isa ${context_name}         # Load and view this context"
            ;;
        help|--help|-h)
            cat <<EOF
╔════════════════════════════════════════════════════════════════════╗
║                 ISA - Intelligent Support Assistant               ║
║                    Development Context Manager                     ║
╚════════════════════════════════════════════════════════════════════╝

USAGE:
  isa <command> [options]
  computer <command> [options]   # Same as 'isa'

NATURAL LANGUAGE SUPPORT:
  Both 'isa' and 'computer' support natural language commands.
  If a command is not recognized, ISA will try to interpret it using AI.

COMMANDS:
  load <name>          Load a context by name
  ctx-switch <name>    Switch to a context (alias for load)
  me|my|self          View your personal priorities
  urgent              Show urgent items
  week|weekly         Show this week's tasks
  month|monthly       Show next month's plan
  todo|todos          View all TODO items
  edit                Edit your priorities
  contexts|list       List all available contexts
  new <name> [type]   Create new context (people/places/things)
  status              Show ISA status dashboard
  search <query>      Search across all contexts
  update              Update ISA system from git
  help                Show this help message

AI COMMANDS (with Ollama):
  ask <question>      Ask AI assistant a question
  analyze [type]      AI analysis of context (urgent, me, current)
  suggest [project]   AI suggestions for project or priorities
  ai-status           Show AI integration status

SEMANTIC CONTEXT COMMANDS:
  context-sync        Sync all contexts to vector database
  context-stats       Show vector database statistics
  context-search      Semantic search across contexts
  context-health      Check all semantic services
  context-rebuild     Rebuild vector database index
  context-add <file>  Add a context file to database
  learn <file|text>   Add file or text to current context
  unlearn <filename>  Remove file from current context
  
  Short aliases: ctx-sync, ctx-stats, ctx-search, ctx-health, ctx-rebuild, ctx-add, ctx-switch

CONTEXT STACK COMMANDS:
  push <context>      Push current context to stack and load new one
  pop                 Pop context from stack and return to it
  stack               Show current context stack
  peek                Peek at top of stack without popping
  breadcrumbs         Show context breadcrumb trail
  stack-clear         Clear entire context stack
  stack-history       Show context history
  
  Aliases: context-push, context-pop, context-stack, context-peek, etc.

GOOGLE DRIVE COMMANDS:
  drive-mount         Mount Google Drive for current context
  drive-mount <ctx>   Mount Google Drive for specific context
  drive-unmount       Unmount Google Drive for current context
  drive-status        Show Google Drive mount status
  drive-list          List all configured Google Drives
  drive-setup <ctx>   Setup rclone remote for context
  
  Aliases: gdrive-mount, mount-drive, gdrive-unmount, etc.

SUB-CONTEXT COMMANDS:
  sub-create <name> <parent1> [parent2...]  Create sub-context from multiple parents (blended)
  sub-list                                  List all sub-contexts
  sub-info <name>                          Show sub-context details and blending info
  sub-delete <name>                        Delete sub-context (safe, doesn't affect parents)
  sub-sync <name>                          Re-sync sub-context from all parents (overwrites)
  sub-cleanup                              Clean up orphaned sub-contexts
  
  Aliases: subcreate, sublist, subinfo, subdelete, subsync, subcleanup

ALIASES:
  isa-me              View priorities
  isa-urgent          Show urgent items
  isa-week            Show this week's tasks
  isa-matrix          Show priority matrix
  isa-todo            View all TODOs
  isa-load <name>     Load a context
  
  cdisa               Navigate to ISA directory
  cdconfig            Navigate to ISA config
  cdme                Navigate to your context directory

EXAMPLES:
  isa me                                    # View your priorities
  computer urgent                           # Check urgent items  
  computer ask "What's next?"                # Ask AI for guidance
  computer , "What's next?"                  # Conversational syntax (same as above)
  computer "What should I focus on?"         # Direct question syntax
  computer 'How is the deployment?'         # Single quotes also work
  isa analyze urgent                        # AI analysis of urgent items
  computer suggest current                  # AI suggestions for current project
  isa ai-status                             # Check AI integration
  
  isa new john-smith                        # Create new person context
  isa new aws-production places             # Create new place context
  isa new kubernetes-cluster things         # Create new thing context
  isa new team-lead --switch                # Create and switch to context
  computer create new context alice         # Natural language creation
  computer make new context project-x places # Natural language with type
  
  computer show stats                       # Imperative → isa ctx-stats
  computer are the services healthy         # Natural language → isa ctx-health
  computer find deployment                  # Imperative → isa ctx-search
  computer sync                             # Imperative → isa ctx-sync
  
  isa show contexts                         # Natural language → isa contexts
  isa display available contexts            # Natural language → isa contexts
  isa check health                          # Natural language → isa ctx-health
  isa what contexts do we have              # Natural language → isa contexts
  
  isa ctx-stats                             # Traditional form
  isa ctx-search "deployment"                # Traditional form
  isa ctx-health                            # Traditional form
  isa ctx-sync                              # Traditional form
  
  isa learn meeting-notes.md                # Add file to current context
  isa learn "Remember to call Bob tomorrow" # Add text note to current context
  isa unlearn note-20251018-012345.md       # Remove file from current context
  
  isa push ahmed-masud                      # Push current, load ahmed-masud
  isa pop                                   # Return to previous context
  isa stack                                 # Show context stack
  computer push context resiliate           # Natural language push
  computer go back                          # Natural language pop
  
  isa drive-mount                           # Mount drive for current context
  isa drive-mount ahmed-masud               # Mount specific context drive
  isa drive-status                          # Show Google Drive status
  computer mount google drive               # Natural language mount
  
  isa sub-create experiment-1 resiliate     # Create sub-context from single parent
  isa sub-create mixed-proj resiliate ahmed-masud  # Blend multiple parents
  isa sub-list                              # List all sub-contexts and blending info
  isa sub-delete experiment-1               # Delete when done (safe)
  computer create sub-context test ahmed-masud resiliate  # Natural language blended sub-context

LOCATION:
  Root: ${ISA_ROOT}
  Config: ${ISA_CONFIG}
  Your Context: ${ISA_CONTEXTS}/people/ahmed-masud/
  
For more help: cat ${ISA_ROOT}/QUICK-START.md
EOF
            ;;
        *)
            # Not a known ISA command - try natural language interpretation
            if [[ -n "${cmd}" ]]; then
                echo "🤖 Interpreting: ${cmd} $@"
                python3 ${ISA_ROOT}/tools/command_intent.py "${cmd}" "$@"
            else
                echo "Unknown command: ${cmd}"
                echo "Run 'isa help' for usage information"
                return 1
            fi
            ;;
    esac
}

# Computer function - handles both ISA commands and natural language
computer() {
    local first_arg="${1:-}"
    local full_input="$*"
    
    # Check for conversational syntax: computer, "question" or computer "question"
    # If input starts with comma or is quoted, treat as direct AI question
    if [[ "${first_arg}" =~ ^, ]] || [[ "${full_input}" =~ ^".*"$ ]] || [[ "${full_input}" =~ ^'.*'$ ]]; then
        # Remove leading comma and whitespace, then strip quotes if present
        local question="${full_input#,}"
        question="${question# }"
        question="${question%\"}"
        question="${question#\"}"
        question="${question%\'}"
        question="${question#\'}"
        
        if [[ -n "${question}" ]]; then
            isa ask "${question}"
        else
            isa ask
        fi
        return
    fi
    
    # Check if it's a direct ISA command first
    case "${first_arg}" in
        me|urgent|week|month|todo|edit|status|help|load|ctx-switch|contexts|list|search|update|\
        ask|analyze|suggest|ai-status|\
        context-sync|ctx-sync|context-stats|ctx-stats|context-search|ctx-search|\
        context-health|ctx-health|context-rebuild|ctx-rebuild|context-add|ctx-add|\
        learn|unlearn|\
        push|context-push|pop|context-pop|stack|context-stack|peek|context-peek|\
        breadcrumbs|context-breadcrumbs|stack-clear|context-clear|stack-history|context-history|\
        drive-mount|gdrive-mount|mount-drive|drive-unmount|gdrive-unmount|unmount-drive|\
        drive-status|gdrive-status|drive-list|gdrive-list|list-drives|drive-setup|gdrive-setup|\
        sub-create|subcreate|sub-list|sublist|sub-info|subinfo|sub-delete|subdelete|\
        sub-sync|subsync|sub-cleanup|subcleanup|new|create)
            # Known ISA command, pass through
            isa "$@"
            ;;
        *)
            # Not a known ISA command - try natural language interpretation
            if [[ -n "${first_arg}" ]]; then
                echo "🤖 Interpreting: $@"
                python3 ${ISA_ROOT}/tools/command_intent.py "$@"
            else
                # No arguments - show help
                isa help
            fi
            ;;
    esac
}

# Quick context loader with tab completion
_isa_load_completion() {
    local contexts=()
    for type in people places things; do
        if [[ -d "${ISA_CONTEXTS}/${type}" ]]; then
            for ctx in "${ISA_CONTEXTS}/${type}/"*; do
	    	[[ -d "$ctx" ]] || continue
                contexts+=($(basename ${ctx}))
            done
        fi
    done
    compadd -a contexts
}

# Register completion if using zsh
if [[ -n "${ZSH_VERSION}" ]]; then
    compdef _isa_load_completion isa-load
fi

# Quick priority check function
isa-check() {
    echo "╔════════════════════════════════════════════════════════╗"
    echo "║           Quick Priority Check                         ║"
    echo "╚════════════════════════════════════════════════════════╝"
    echo ""
    echo "🔥 URGENT (Next 5 days):"
    grep -A 8 "Status.*NOT STARTED" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null | head -12
    echo ""
    echo "📅 This Week:"
    grep -A 6 "This Week" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null | tail -5
}

