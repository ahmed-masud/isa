}

# Helper function to display markdown with syntax highlighting
isa-show-markdown() {
    local file="$1"
    if [[ -z "$file" ]]; then
        echo "Usage: isa-show-markdown <markdown-file>"
        return 1
    fi
    
    if [[ ! -f "$file" ]]; then
        echo "❌ File not found: $file"
        return 1
    fi
    
    # Check if bat is available
    if command -v bat >/dev/null 2>&1; then
        echo "📖 Displaying: $file"
        echo "───────────────────────────────────────────────────────────────────"
        bat --style=numbers,changes,header --color=always --language=markdown "$file"
    else
        # Fallback to cat if bat is not available
        echo "📖 Displaying: $file (no syntax highlighting - install 'bat' for colors)"
        echo "───────────────────────────────────────────────────────────────────"
        cat "$file"
    fi
}

# Multiple markdown display options
alias show-md='isa-show-markdown'        # Full bat display with colors
alias mdcat='isa-show-markdown'         # Same as show-md
alias mdplain='isa-markdown-plain'      # Plain text with simple formatting

# Simple markdown viewer without colors (for when bat colors don't work)
isa-markdown-plain() {
    local file="$1"
    if [[ -z "$file" ]]; then
        echo "Usage: isa-markdown-plain <markdown-file>"
        return 1
    fi
    
    if [[ ! -f "$file" ]]; then
        echo "❌ File not found: $file"
        return 1
    fi
    
    echo "📖 Displaying: $file (plain text)"
    echo "───────────────────────────────────────────────────────────────────"
    cat "$file"
}

