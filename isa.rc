# Quick jump to project based on context
cdproject() {
    local project="$1"
    case "${project}" in
        chatgpt|ollama)
            cd ${HOME}/projects/ahmed-masud
            ;;
        isa|assistant)
            cd ${ISA_ROOT}
            ;;
        config|data)
            cd ${ISA_CONFIG}
            ;;
        aifs|resiliate)
            cd ${ISA_CONFIG}/resiliate-backend
            ;;
        *)
            echo "Unknown project: ${project}"
            echo "Available: chatgpt, isa, config, aifs"
            return 1
            ;;
    esac
    pwd
}

# ============================================================================
# ISA TOOLS AUTO-INSTALLER
# ============================================================================

# Install/update ISA tools (symlinks to load-context.sh)
isa-install() {
    echo "🔧 Installing ISA tools..."
    
    # Create symlink for ISA command in ~/.local/bin
    if [[ -f "${ISA_ROOT}/load-context.sh" ]]; then
        ln -sf "${ISA_ROOT}/load-context.sh" "${ISA_BIN}/isa-load"
        chmod +x "${ISA_ROOT}/load-context.sh"
        echo "✅ Installed: isa-load"
    fi
    
    # Ensure isa.rc is up to date
    if [[ -f "${ISA_ROOT}/isa.rc" ]]; then
        echo "✅ isa.rc is available at ${ISA_ROOT}/isa.rc"
        echo "   Make sure it's sourced in your .zshrc"
    fi
    
    echo ""
    echo "✨ Installation complete!"
    echo ""
    echo "To enable in new shells, add to ~/.zshrc:"
    echo "  source ${ISA_ROOT}/isa.rc"
    echo ""
}

# ============================================================================
# ISA INITIALIZATION MESSAGE
# ============================================================================

# Show brief status when shell loads (only in interactive shells)
if [[ -o interactive ]] && [[ -z "${ISA_LOADED}" ]]; then
    export ISA_LOADED=1
    
    # Calculate load time
    local load_end=$(date +%s%N 2>/dev/null || date +%s)
    local load_time=0
    if [[ -n "${_ISA_LOADING_START}" ]]; then
        if [[ "$load_end" =~ ^[0-9]+$ ]] && [[ "${_ISA_LOADING_START}" =~ ^[0-9]+$ ]]; then
            # Nanoseconds available
            if [[ ${#load_end} -gt 10 ]]; then
                load_time=$(( (load_end - _ISA_LOADING_START) / 1000000 ))
            else
                # Seconds only
                load_time=$(( (load_end - _ISA_LOADING_START) * 1000 ))
            fi
        fi
    fi
    
    # Compact status message
    local urgent_count=0
    if [[ -f "${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md" ]]; then
        urgent_count=$(grep -c "Status.*NOT STARTED.*Deadline" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null || echo "0")
        # Ensure it's a valid number
        [[ ! "${urgent_count}" =~ ^[0-9]+$ ]] && urgent_count=0
    fi
    
    # Single line status with OS info
    local os_label="🐧"  # Linux penguin
    [[ "${ISA_OS}" == "macos" ]] && os_label="🍎"  # Apple
    
    if [[ ${urgent_count:-0} -gt 0 ]]; then
        echo "✨ ISA loaded (${load_time}ms) ${os_label} | 🔥 ${urgent_count} urgent items | isa help"
    else
        echo "✨ ISA loaded (${load_time}ms) ${os_label} | isa help for commands"
    fi
    
    unset _ISA_LOADING_START
fi

# ============================================================================
# COMPLETION SETUP
# ============================================================================

# Zsh completions for ISA command
if [[ -n "${ZSH_VERSION}" ]]; then
    _isa() {
        local -a commands
        commands=(
            'load:Load a context by name'
            'me:View your priorities'
            'urgent:Show urgent items'
            'week:Show this week tasks'
            'month:Show next month plan'
            'todo:View all TODOs'
            'edit:Edit priorities'
            'contexts:List all contexts'
            'status:Show status dashboard'
            'search:Search contexts'
            'update:Update ISA system'
            'help:Show help'
        )
        _describe 'isa command' commands
    }
    
    compdef _isa isa
    compdef _isa computer
fi

# ============================================================================
# PATH VERIFICATION
# ============================================================================

# Ensure ~/.local/bin is in PATH
if [[ ":${PATH}:" != *":${HOME}/.local/bin:"* ]]; then
    export PATH="${HOME}/.local/bin:${PATH}"
fi

# ============================================================================
# CAFFEINATE HELPERS (Prevent Sleep During Operations)
# ============================================================================

# Prevent sleep for duration (in seconds) - Cross-platform
isa-caffeinate() {
    local duration="${1:-3600}"  # Default 1 hour
    echo "☕ Keeping system awake for ${duration} seconds..."
    echo "   Press Ctrl+C to stop"
    
    if [[ "${ISA_OS}" == "macos" ]]; then
        caffeinate -disu -t ${duration}
    elif [[ "${ISA_OS}" == "linux" ]]; then
        if command -v systemd-inhibit >/dev/null 2>&1; then
            systemd-inhibit --what=idle:sleep:handle-lid-switch --who="ISA" --why="User request" sleep ${duration}
        elif command -v gnome-session-inhibit >/dev/null 2>&1; then
            gnome-session-inhibit --inhibit idle:suspend --inhibit-only sleep ${duration}
        else
            echo "⚠️  No sleep prevention tool found on Linux"
            echo "   Install systemd or gnome-session for this feature"
            return 1
        fi
    else
        echo "⚠️  Unsupported OS: ${ISA_OS}"
        return 1
    fi
}

# Prevent sleep while running a command - Cross-platform
isa-nosleep() {
    if [[ -z "$1" ]]; then
        echo "Usage: isa-nosleep <command>"
        echo "Example: isa-nosleep 'long-running-script.sh'"
        return 1
    fi
    echo "☕ Running with sleep prevention..."
    
    if [[ "${ISA_OS}" == "macos" ]]; then
        caffeinate -disu "$@"
    elif [[ "${ISA_OS}" == "linux" ]]; then
        if command -v systemd-inhibit >/dev/null 2>&1; then
            systemd-inhibit --what=idle:sleep:handle-lid-switch --who="ISA" --why="Running command" "$@"
        elif command -v gnome-session-inhibit >/dev/null 2>&1; then
            gnome-session-inhibit --inhibit idle:suspend "$@"
        else
            echo "⚠️  No sleep prevention tool found, running command anyway..."
            "$@"
        fi
    else
        echo "⚠️  Unsupported OS, running command anyway..."
        "$@"
    fi
}

# Toggle indefinite caffeinate (background process) - Cross-platform
isa-awake() {
    if [[ "${ISA_OS}" == "macos" ]]; then
        if pgrep -f "caffeinate -disu" > /dev/null; then
            pkill -f "caffeinate -disu"
            echo "😴 System can now sleep normally"
        else
            caffeinate -disu &
            echo "☕ System will stay awake indefinitely"
            echo "   Run 'isa-awake' again to allow sleep"
        fi
    elif [[ "${ISA_OS}" == "linux" ]]; then
        # Check if systemd-inhibit is running
        if pgrep -f "systemd-inhibit.*ISA-keep-awake" > /dev/null; then
            pkill -f "systemd-inhibit.*ISA-keep-awake"
            echo "😴 System can now sleep normally"
        else
            if command -v systemd-inhibit >/dev/null 2>&1; then
                # Run indefinitely with a long sleep
                (systemd-inhibit --what=idle:sleep:handle-lid-switch --who="ISA-keep-awake" --why="User request" sleep infinity &)
                echo "☕ System will stay awake indefinitely"
                echo "   Run 'isa-awake' again to allow sleep"
            else
                echo "⚠️  systemd-inhibit not found on this Linux system"
                echo "   Install systemd for this feature"
                return 1
            fi
        fi
    else
        echo "⚠️  Unsupported OS: ${ISA_OS}"
        return 1
    fi
}

# ============================================================================
# USER CONFIGURATION LOADING
# ============================================================================

# Load user configuration if it exists (suppress output)
if [[ -f "${ISA_CONFIG}/.isarc" ]]; then
    source "${ISA_CONFIG}/.isarc" 2>/dev/null
fi

# Load AI/Ollama integration module if available (suppress output)
if [[ -f "${ISA_ROOT}/modules/ollama-client.sh" ]]; then
    source "${ISA_ROOT}/modules/ollama-client.sh" 2>/dev/null
fi

