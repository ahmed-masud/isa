#!/bin/zsh
# ISA (Intelligent Support Assistant) Shell Configuration
# Universal configuration - works on macOS and Linux
# Source this file from your .zshrc or .bashrc
# Location: ~/projects/isa/isa.rc
# Last Updated: 2025-10-12

# ============================================================================
# ISA ENVIRONMENT SETUP
# ============================================================================

# ISA tool/codebase location
export ISA_ROOT="${HOME}/projects/isa"

# User config/data location
export ISA_CONFIG="${HOME}/.config/isa"
export ISA_CONTEXTS="${ISA_CONFIG}/contexts"
export ISA_BIN="${HOME}/.local/bin"

# Ensure ISA directories exist
[[ ! -d "${ISA_ROOT}" ]] && mkdir -p "${ISA_ROOT}"
[[ ! -d "${ISA_CONFIG}" ]] && mkdir -p "${ISA_CONFIG}"
[[ ! -d "${ISA_CONTEXTS}" ]] && mkdir -p "${ISA_CONTEXTS}"
[[ ! -d "${ISA_BIN}" ]] && mkdir -p "${ISA_BIN}"

# ============================================================================
# ISA CORE ALIASES
# ============================================================================

# Context Management
alias isa-load='${ISA_ROOT}/load-context.sh'
alias isa-me='cat ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias isa-index='cat ${ISA_CONTEXTS}/people/ahmed-masud/INDEX.md'
alias isa-urgent='grep -A 30 "URGENT PRIORITIES" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias isa-week='grep -A 20 "This Week" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias isa-matrix='grep -A 10 "PRIORITY MATRIX" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias isa-todo='cat ${ISA_ROOT}/TODO.md'
alias isa-roadmap='cat ${ISA_ROOT}/ROADMAP.md'
alias isa-help='cat ${ISA_ROOT}/QUICK-START.md'

# Quick edits
alias isa-edit-priorities='${EDITOR:-vim} ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias isa-edit-todo='${EDITOR:-vim} ${ISA_ROOT}/TODO.md'
alias isa-edit-context='${EDITOR:-vim} ${ISA_CONTEXTS}/people/ahmed-masud/README.md'

# Navigation
alias cdisa='cd ${ISA_ROOT}'          # Go to ISA tool code
alias cdconfig='cd ${ISA_CONFIG}'     # Go to ISA config
alias cdme='cd ${ISA_CONTEXTS}/people/ahmed-masud'
alias cdcontexts='cd ${ISA_CONTEXTS}'

# Project navigation (from priorities)
alias cdchatgpt='cd ${HOME}/projects/ahmed-masud'
alias cdresiliate='cd ${ISA_CONFIG}/resiliate-backend'

# ============================================================================
# ISA FUNCTIONS
# ============================================================================

# Main ISA command function
isa() {
    local cmd="${1:-help}"
    shift
    
    case "${cmd}" in
        load)
            ${ISA_ROOT}/load-context.sh "$@"
            ;;
        me|my|self)
            cat ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md | ${PAGER:-less}
            ;;
        urgent)
            grep -A 40 "URGENT PRIORITIES" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md
            ;;
        week|weekly)
            echo "=== This Week's Tasks ==="
            grep -A 20 "This Week" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md
            ;;
        month|monthly)
            echo "=== Next Month's Plan ==="
            grep -A 15 "Next Month" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md
            ;;
        todo|todos)
            cat ${ISA_ROOT}/TODO.md | ${PAGER:-less}
            ;;
        edit)
            ${EDITOR:-vim} ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md
            ;;
        contexts|list)
            echo "Available contexts:"
            echo ""
            for type in people places things; do
                if [[ -d "${ISA_CONTEXTS}/${type}" ]]; then
                    echo "📂 ${type}:"
                    exa --time-style=long-iso --git -g -1 "${ISA_CONTEXTS}/${type}" 2>/dev/null | sed 's/^/  - /' || ls -1 "${ISA_CONTEXTS}/${type}" 2>/dev/null | sed 's/^/  - /'
                fi
            done
            ;;
        status)
            echo "╔════════════════════════════════════════════════════════╗"
            echo "║              ISA Status Dashboard                      ║"
            echo "╚════════════════════════════════════════════════════════╝"
            echo ""
            echo "📍 Location: ${ISA_ROOT}"
            echo "👤 Context: Ahmed Masud"
            echo ""
            echo "🔥 Urgent Items:"
            grep -A 5 "Status.*NOT STARTED\|Status.*IN PROGRESS" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null | head -10
            echo ""
            echo "📊 Priority Matrix:"
            grep -A 6 "Priority Matrix" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null | tail -5
            ;;
        search)
            if [[ -z "$1" ]]; then
                echo "Usage: isa search <query>"
                return 1
            fi
            echo "🔍 Searching contexts for: $@"
            grep -r "$@" ${ISA_CONTEXTS}/ 2>/dev/null
            ;;
        update)
            echo "🔄 Updating ISA system..."
            cd ${ISA_ROOT}
            if [[ -d .git ]]; then
                git pull
                echo "✅ ISA updated successfully"
            else
                echo "⚠️  No git repository found. Manual update required."
            fi
            ;;
        ask)
            if command -v isa_ai_ask >/dev/null 2>&1; then
                isa_ai_ask "$@"
            else
                echo "❌ AI integration not available. Load ollama-client module first."
            fi
            ;;
        ai-analyze|analyze)
            if command -v isa_ai_analyze >/dev/null 2>&1; then
                isa_ai_analyze "$@"
            else
                echo "❌ AI integration not available. Load ollama-client module first."
            fi
            ;;
        suggest)
            if command -v isa_ai_suggest >/dev/null 2>&1; then
                isa_ai_suggest "$@"
            else
                echo "❌ AI integration not available. Load ollama-client module first."
            fi
            ;;
        ai-status)
            if command -v isa_ai_status >/dev/null 2>&1; then
                isa_ai_status
            else
                echo "❌ AI integration not available. Load ollama-client module first."
            fi
            ;;
        do)
            # Natural language command interpretation
            if [[ -z "$1" ]]; then
                echo "Usage: computer do <natural language command>"
                echo "Example: computer do show me context stats"
                echo "Example: computer do search for deployment procedures"
                return 1
            fi
            echo "🤖 Interpreting: $@"
            python3 ${ISA_ROOT}/tools/command_intent.py "$@"
            ;;
        context-sync|ctx-sync)
            echo "🔄 Processing contexts into vector database..."
            local count=0
            for file in $(find ${ISA_CONTEXTS} -name "*.md" -type f); do
                echo "  Processing: ${file##*/}"
                python3 ${ISA_ROOT}/tools/chunk_and_embed.py "$file" 2>/dev/null && ((count++))
            done
            echo "✅ Processed $count context files"
            ;;
        context-stats|ctx-stats)
            echo "📊 Vector Database Statistics"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            curl -s http://192.168.1.161:8000/stats 2>/dev/null | python3 -c "import json, sys; data=json.load(sys.stdin); print(f'  Total Chunks: {data.get(\"total_chunks\", 0)}\n  Trained: {data.get(\"is_trained\", False)}\n  Storage: {data.get(\"storage_dir\", \"unknown\")}')" || echo "  ❌ Vector service not available"
            ;;
        context-search|ctx-search)
            if [[ -z "$1" ]]; then
                echo "Usage: isa context-search <query>"
                echo "Example: isa context-search 'deployment procedures'"
                return 1
            fi
            echo "🔍 Semantic Search: $@"
            echo ""
            python3 ${ISA_ROOT}/tools/semantic_context.py "$@" --format text 2>/dev/null || echo "❌ Semantic search failed"
            ;;
        context-rebuild|ctx-rebuild)
            echo "🔨 Rebuilding vector database index..."
            curl -s -X POST http://192.168.1.161:8000/rebuild 2>/dev/null | python3 -c "import json, sys; data=json.load(sys.stdin); print(f'✅ Rebuilt: {data.get(\"total_chunks\", 0)} chunks')" || echo "❌ Rebuild failed"
            ;;
        context-health|ctx-health)
            echo "🏥 Checking semantic context services..."
            echo ""
            
            # Check vector database
            echo "Vector Database (192.168.1.161:8000):"
            if curl -s http://192.168.1.161:8000/health 2>/dev/null | grep -q "healthy"; then
                echo "  ✅ Healthy"
            else
                echo "  ❌ Unavailable"
            fi
            
            # Check Ollama
            echo ""
            echo "Ollama AI (192.168.1.161:11434):"
            if curl -s http://192.168.1.161:11434/api/tags 2>/dev/null | grep -q "models"; then
                echo "  ✅ Healthy"
            else
                echo "  ❌ Unavailable"
            fi
            
            # Check context watcher
            echo ""
            echo "Context Watcher (local):"
            if ps aux | grep -v grep | grep -q "context_watcher.py"; then
                echo "  ✅ Running"
            else
                echo "  ⚠️  Not running"
            fi
            ;;
        context-add|ctx-add)
            if [[ -z "$1" ]]; then
                echo "Usage: isa context-add <markdown-file>"
                return 1
            fi
            if [[ ! -f "$1" ]]; then
                echo "❌ File not found: $1"
                return 1
            fi
            echo "📝 Adding context to vector database..."
            python3 ${ISA_ROOT}/tools/chunk_and_embed.py "$1" 2>/dev/null && echo "✅ Context added successfully" || echo "❌ Failed to add context"
            ;;
        help|--help|-h)
            cat <<EOF
╔════════════════════════════════════════════════════════════════════╗
║                 ISA - Intelligent Support Assistant               ║
║                    Development Context Manager                     ║
╚════════════════════════════════════════════════════════════════════╝

USAGE:
  isa <command> [options]
  computer <command> [options]   # Same as 'isa'

COMMANDS:
  load <name>          Load a context by name
  me|my|self          View your personal priorities
  urgent              Show urgent items
  week|weekly         Show this week's tasks
  month|monthly       Show next month's plan
  todo|todos          View all TODO items
  edit                Edit your priorities
  contexts|list       List all available contexts
  status              Show ISA status dashboard
  search <query>      Search across all contexts
  update              Update ISA system from git
  help                Show this help message

AI COMMANDS (with Ollama):
  ask <question>      Ask AI assistant a question
  analyze [type]      AI analysis of context (urgent, me, current)
  suggest [project]   AI suggestions for project or priorities
  ai-status           Show AI integration status
  do <command>        Natural language command interpretation
                      (e.g., "computer do show me stats")

SEMANTIC CONTEXT COMMANDS:
  context-sync        Sync all contexts to vector database
  context-stats       Show vector database statistics
  context-search      Semantic search across contexts
  context-health      Check all semantic services
  context-rebuild     Rebuild vector database index
  context-add <file>  Add a context file to database
  
  Short aliases: ctx-sync, ctx-stats, ctx-search, ctx-health, ctx-rebuild, ctx-add

ALIASES:
  isa-me              View priorities
  isa-urgent          Show urgent items
  isa-week            Show this week's tasks
  isa-matrix          Show priority matrix
  isa-todo            View all TODOs
  isa-load <name>     Load a context
  
  cdisa               Navigate to ISA directory
  cdconfig            Navigate to ISA config
  cdme                Navigate to your context directory

EXAMPLES:
  isa me                                    # View your priorities
  computer urgent                           # Check urgent items  
  computer ask "What's next?"                # Ask AI for guidance
  isa analyze urgent                        # AI analysis of urgent items
  computer suggest current                  # AI suggestions for current project
  isa ai-status                             # Check AI integration
  
  computer do show me context stats         # Natural language → isa ctx-stats
  computer do search for deployment         # Natural language → isa ctx-search
  computer do check if services are healthy # Natural language → isa ctx-health
  
  isa ctx-stats                             # Show vector database stats
  isa ctx-search "deployment"                # Search contexts semantically
  isa ctx-health                            # Check all services
  isa ctx-sync                              # Sync all contexts to DB

LOCATION:
  Root: ${ISA_ROOT}
  Config: ${ISA_CONFIG}
  Your Context: ${ISA_CONTEXTS}/people/ahmed-masud/
  
For more help: cat ${ISA_ROOT}/QUICK-START.md
EOF
            ;;
        *)
            echo "Unknown command: ${cmd}"
            echo "Run 'isa help' for usage information"
            return 1
            ;;
    esac
}

# Computer alias - same as isa command but more natural
computer() {
    isa "$@"
}

# Quick context loader with tab completion
_isa_load_completion() {
    local contexts=()
    for type in people places things; do
        if [[ -d "${ISA_CONTEXTS}/${type}" ]]; then
            for ctx in ${ISA_CONTEXTS}/${type}/*(/); do
                contexts+=($(basename ${ctx}))
            done
        fi
    done
    compadd -a contexts
}

# Register completion if using zsh
if [[ -n "${ZSH_VERSION}" ]]; then
    compdef _isa_load_completion isa-load
fi

# Quick priority check function
isa-check() {
    echo "╔════════════════════════════════════════════════════════╗"
    echo "║           Quick Priority Check                         ║"
    echo "╚════════════════════════════════════════════════════════╝"
    echo ""
    echo "🔥 URGENT (Next 5 days):"
    grep -A 8 "Status.*NOT STARTED" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null | head -12
    echo ""
    echo "📅 This Week:"
    grep -A 6 "This Week" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null | tail -5
}

# Morning routine - run this when you start your day
isa-morning() {
    clear
    echo "╔════════════════════════════════════════════════════════════════════╗"
    echo "║                  Good Morning, Ahmed! 🌅                           ║"
    echo "║                   ISA is ready to assist                           ║"
    echo "╚════════════════════════════════════════════════════════════════════╝"
    echo ""
    echo "📅 Date: $(date '+%A, %B %d, %Y')"
    echo "⏰ Time: $(date '+%I:%M %p')"
    echo ""
    echo "────────────────────────────────────────────────────────────────────"
    echo ""
    
    # Check urgent items
    echo "🔥 URGENT ITEMS:"
    grep -A 10 "URGENT PRIORITIES" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null | head -15
    echo ""
    
    # Check this week
    echo "📋 THIS WEEK'S FOCUS:"
    grep -A 8 "This Week" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null | tail -6
    echo ""
    
    echo "────────────────────────────────────────────────────────────────────"
    echo ""
    echo "💡 Quick Commands:"
    echo "  isa me          - View full priorities"
    echo "  isa urgent      - Show urgent details"
    echo "  isa-week        - This week's tasks"
    echo "  isa todo        - View all TODOs"
    echo ""
}

# Evening review - run this at end of day
isa-evening() {
    clear
    echo "╔════════════════════════════════════════════════════════════════════╗"
    echo "║                  End of Day Review 🌙                              ║"
    echo "║                   ISA Daily Summary                                 ║"
    echo "╚════════════════════════════════════════════════════════════════════╝"
    echo ""
    echo "📅 Date: $(date '+%A, %B %d, %Y')"
    echo ""
    
    echo "📊 Priority Status:"
    grep -A 6 "PRIORITY MATRIX" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null | tail -5
    echo ""
    
    echo "────────────────────────────────────────────────────────────────────"
    echo ""
    echo "💡 Tomorrow's Prep:"
    echo "  • Update PRIORITIES.md with today's progress"
    echo "  • Review urgent deadlines"
    echo "  • Plan tomorrow's focus area"
    echo ""
    echo "Quick edit: isa edit"
    echo ""
}

# ============================================================================
# ISA SMART NAVIGATION
# ============================================================================

# Quick jump to project based on context
cdproject() {
    local project="$1"
    case "${project}" in
        chatgpt|ollama)
            cd ${HOME}/projects/ahmed-masud
            ;;
        isa|assistant)
            cd ${ISA_ROOT}
            ;;
        config|data)
            cd ${ISA_CONFIG}
            ;;
        aifs|resiliate)
            cd ${ISA_CONFIG}/resiliate-backend
            ;;
        *)
            echo "Unknown project: ${project}"
            echo "Available: chatgpt, isa, config, aifs"
            return 1
            ;;
    esac
    pwd
}

# ============================================================================
# ISA TOOLS AUTO-INSTALLER
# ============================================================================

# Install/update ISA tools (symlinks to load-context.sh)
isa-install() {
    echo "🔧 Installing ISA tools..."
    
    # Create symlink for ISA command in ~/.local/bin
    if [[ -f "${ISA_ROOT}/load-context.sh" ]]; then
        ln -sf "${ISA_ROOT}/load-context.sh" "${ISA_BIN}/isa-load"
        chmod +x "${ISA_ROOT}/load-context.sh"
        echo "✅ Installed: isa-load"
    fi
    
    # Ensure isa.rc is up to date
    if [[ -f "${ISA_ROOT}/isa.rc" ]]; then
        echo "✅ isa.rc is available at ${ISA_ROOT}/isa.rc"
        echo "   Make sure it's sourced in your .zshrc"
    fi
    
    echo ""
    echo "✨ Installation complete!"
    echo ""
    echo "To enable in new shells, add to ~/.zshrc:"
    echo "  source ${ISA_ROOT}/isa.rc"
    echo ""
}

# ============================================================================
# ISA INITIALIZATION MESSAGE
# ============================================================================

# Show brief status when shell loads (only in interactive shells)
if [[ -o interactive ]] && [[ -z "${ISA_LOADED}" ]]; then
    export ISA_LOADED=1
    
    # Only show if priorities file exists
    if [[ -f "${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md" ]]; then
        echo "✨ ISA (Issa) loaded | Type 'isa help' for commands | 'isa-morning' for daily brief"
        
        # Check for urgent items and show notification
        if grep -q "Status.*NOT STARTED.*Deadline" ${ISA_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null; then
            echo "⚠️  URGENT: You have items with approaching deadlines! Run 'isa urgent'"
        fi
    else
        echo "✨ ISA (Issa) loaded | Type 'isa help' for commands"
        echo "💡 Create your first context: isa edit"
    fi
fi

# ============================================================================
# COMPLETION SETUP
# ============================================================================

# Zsh completions for ISA command
if [[ -n "${ZSH_VERSION}" ]]; then
    _isa() {
        local -a commands
        commands=(
            'load:Load a context by name'
            'me:View your priorities'
            'urgent:Show urgent items'
            'week:Show this week tasks'
            'month:Show next month plan'
            'todo:View all TODOs'
            'edit:Edit priorities'
            'contexts:List all contexts'
            'status:Show status dashboard'
            'search:Search contexts'
            'update:Update ISA system'
            'help:Show help'
        )
        _describe 'isa command' commands
    }
    
    compdef _isa isa
    compdef _isa computer
fi

# ============================================================================
# PATH VERIFICATION
# ============================================================================

# Ensure ~/.local/bin is in PATH
if [[ ":${PATH}:" != *":${HOME}/.local/bin:"* ]]; then
    export PATH="${HOME}/.local/bin:${PATH}"
fi

# ============================================================================
# CAFFEINATE HELPERS (Prevent Sleep During Operations)
# ============================================================================

# Prevent sleep for duration (in seconds)
isa-caffeinate() {
    local duration="${1:-3600}"  # Default 1 hour
    echo "☕ Keeping system awake for ${duration} seconds..."
    echo "   Press Ctrl+C to stop"
    caffeinate -disu -t ${duration}
}

# Prevent sleep while running a command
isa-nosleep() {
    if [[ -z "$1" ]]; then
        echo "Usage: isa-nosleep <command>"
        echo "Example: isa-nosleep 'long-running-script.sh'"
        return 1
    fi
    echo "☕ Running with caffeinate (system won't sleep)..."
    caffeinate -disu "$@"
}

# Toggle indefinite caffeinate (background process)
isa-awake() {
    if pgrep -f "caffeinate -disu" > /dev/null; then
        pkill -f "caffeinate -disu"
        echo "😴 System can now sleep normally"
    else
        caffeinate -disu &
        echo "☕ System will stay awake indefinitely"
        echo "   Run 'isa-awake' again to allow sleep"
    fi
}

# ============================================================================
# USER CONFIGURATION LOADING
# ============================================================================

# Load user configuration if it exists
if [[ -f "${ISA_CONFIG}/.isarc" ]]; then
    source "${ISA_CONFIG}/.isarc"
fi

# Load AI/Ollama integration module if available
if [[ -f "${ISA_ROOT}/modules/ollama-client.sh" ]]; then
    source "${ISA_ROOT}/modules/ollama-client.sh"
fi

# ============================================================================
# END OF ISA CONFIGURATION
# ============================================================================