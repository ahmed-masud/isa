# USER CONFIGURATION LOADING
# ============================================================================

# Load user configuration if it exists
if [[ -f "${ISA_CONFIG}/.isarc" ]]; then
    source "${ISA_CONFIG}/.isarc"
fi

# Load AI/Ollama integration module if available
if [[ -f "${ISA_ROOT}/modules/ollama-client.sh" ]]; then
    source "${ISA_ROOT}/modules/ollama-client.sh"
fi

