# ============================================================================
# CAFFEINATE HELPERS (Prevent Sleep During Operations)
# ============================================================================

# Prevent sleep for duration (in seconds)
vdev-caffeinate() {
    local duration="${1:-3600}"  # Default 1 hour
    echo "☕ Keeping system awake for ${duration} seconds..."
    echo "   Press Ctrl+C to stop"
    caffeinate -disu -t ${duration}
}

# Prevent sleep while running a command
vdev-nosleep() {
    if [[ -z "$1" ]]; then
        echo "Usage: vdev-nosleep <command>"
        echo "Example: vdev-nosleep 'long-running-script.sh'"
        return 1
    fi
    echo "☕ Running with caffeinate (system won't sleep)..."
    caffeinate -disu "$@"
}

# Toggle indefinite caffeinate (background process)
vdev-awake() {
    if pgrep -f "caffeinate -disu" > /dev/null; then
        pkill -f "caffeinate -disu"
        echo "😴 System can now sleep normally"
    else
        caffeinate -disu &
        echo "☕ System will stay awake indefinitely"
        echo "   Run 'vdev-awake' again to allow sleep"
    fi
}

