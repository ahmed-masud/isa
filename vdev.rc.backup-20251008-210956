# ============================================================================
# VDEV SMART NAVIGATION
# ============================================================================

# Quick jump to project based on context
cdproject() {
    local project="$1"
    case "${project}" in
        chatgpt|ollama)
            cd ${HOME}/projects/ahmed-masud
            ;;
        vdev|vibe)
            cd ${VDEV_ROOT}
            ;;
        vdata|data)
            cd ${VDEV_DATA}
            ;;
        aifs|resiliate)
            cd ${VDEV_DATA}/resiliate-backend
            ;;
        *)
            echo "Unknown project: ${project}"
            echo "Available: chatgpt, vdev, vdata, aifs"
            return 1
            ;;
    esac
    pwd
}

# ============================================================================
# VDEV TOOLS AUTO-INSTALLER
# ============================================================================

# Install/update vdev tools (symlinks to load-context.sh)
vdev-install() {
    echo "🔧 Installing vdev tools..."
    
    # Create symlink for vdev command in ~/.local/bin
    if [[ -f "${VDEV_ROOT}/load-context.sh" ]]; then
        ln -sf "${VDEV_ROOT}/load-context.sh" "${VDEV_BIN}/vdev-load"
        chmod +x "${VDEV_ROOT}/load-context.sh"
        echo "✅ Installed: vdev-load"
    fi
    
    # Ensure vdev.rc is up to date
    if [[ -f "${VDEV_ROOT}/vdev.rc" ]]; then
        echo "✅ vdev.rc is available at ${VDEV_ROOT}/vdev.rc"
        echo "   Make sure it's sourced in your .zshrc"
    fi
    
    echo ""
    echo "✨ Installation complete!"
    echo ""
    echo "To enable in new shells, add to ~/.zshrc:"
    echo "  source ${VDEV_ROOT}/vdev.rc"
    echo ""
}

