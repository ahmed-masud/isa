#!/bin/zsh
# vdev Shell Configuration
# Source this file from your .zshrc or .bashrc
# Location: ~/dev-notes/vibe-dev/vdev.rc
# Last Updated: 2025-10-08

# ============================================================================
# VDEV ENVIRONMENT SETUP
# ============================================================================

# vdev tool/codebase location
export VDEV_ROOT="${HOME}/projects/vibe-dev"

# User config/data location (Samba share)
export VDEV_DATA="${HOME}/vibe-dev"
export VDEV_CONTEXTS="${VDEV_DATA}/contexts"
export VDEV_BIN="${HOME}/.local/bin"

# Ensure vdev directories exist
[[ ! -d "${VDEV_ROOT}" ]] && mkdir -p "${VDEV_ROOT}"
[[ ! -d "${VDEV_DATA}" ]] && mkdir -p "${VDEV_DATA}"
[[ ! -d "${VDEV_CONTEXTS}" ]] && mkdir -p "${VDEV_CONTEXTS}"
[[ ! -d "${VDEV_BIN}" ]] && mkdir -p "${VDEV_BIN}"

# ============================================================================
# VDEV CORE ALIASES
# ============================================================================

# Context Management
alias vdev-load='${VDEV_ROOT}/load-context.sh'
alias vdev-me='cat ${VDEV_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias vdev-index='cat ${VDEV_CONTEXTS}/people/ahmed-masud/INDEX.md'
alias vdev-urgent='grep -A 30 "URGENT PRIORITIES" ${VDEV_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias vdev-week='grep -A 20 "This Week" ${VDEV_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias vdev-matrix='grep -A 10 "PRIORITY MATRIX" ${VDEV_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias vdev-todo='cat ${VDEV_ROOT}/TODO.md'
alias vdev-roadmap='cat ${VDEV_ROOT}/ROADMAP.md'
alias vdev-help='cat ${VDEV_ROOT}/QUICK-START.md'

# Quick edits
alias vdev-edit-priorities='${EDITOR:-vim} ${VDEV_CONTEXTS}/people/ahmed-masud/PRIORITIES.md'
alias vdev-edit-todo='${EDITOR:-vim} ${VDEV_ROOT}/TODO.md'
alias vdev-edit-context='${EDITOR:-vim} ${VDEV_CONTEXTS}/people/ahmed-masud/README.md'

# Navigation
alias cdvdev='cd ${VDEV_ROOT}'          # Go to vibe-dev tool code
alias cdvdata='cd ${VDEV_DATA}'         # Go to vibe-dev user data
alias cdme='cd ${VDEV_CONTEXTS}/people/ahmed-masud'
alias cdcontexts='cd ${VDEV_CONTEXTS}'

# Project navigation (from priorities)
alias cdchatgpt='cd ${HOME}/projects/ahmed-masud'
alias cdresiliate='cd ${VDEV_DATA}/resiliate-backend'

# ============================================================================
# VDEV FUNCTIONS
# ============================================================================

# Load a context by name
vdev() {
    local cmd="${1:-help}"
    shift
    
    case "${cmd}" in
        load)
            ${VDEV_ROOT}/load-context.sh "$@"
            ;;
        me|my|self)
            cat ${VDEV_CONTEXTS}/people/ahmed-masud/PRIORITIES.md | ${PAGER:-less}
            ;;
        urgent)
            grep -A 40 "URGENT PRIORITIES" ${VDEV_CONTEXTS}/people/ahmed-masud/PRIORITIES.md
            ;;
        week|weekly)
            echo "=== This Week's Tasks ==="
            grep -A 20 "This Week" ${VDEV_CONTEXTS}/people/ahmed-masud/PRIORITIES.md
            ;;
        month|monthly)
            echo "=== Next Month's Plan ==="
            grep -A 15 "Next Month" ${VDEV_CONTEXTS}/people/ahmed-masud/PRIORITIES.md
            ;;
        todo|todos)
            cat ${VDEV_ROOT}/TODO.md | ${PAGER:-less}
            ;;
        edit)
            ${EDITOR:-vim} ${VDEV_CONTEXTS}/people/ahmed-masud/PRIORITIES.md
            ;;
        contexts|list)
            echo "Available contexts:"
            echo ""
            for type in people places things; do
                if [[ -d "${VDEV_CONTEXTS}/${type}" ]]; then
                    echo "📂 ${type}:"
                    ls -1 "${VDEV_CONTEXTS}/${type}" 2>/dev/null | sed 's/^/  - /'
                fi
            done
            ;;
        status)
            echo "╔════════════════════════════════════════════════════════╗"
            echo "║              vdev Status Dashboard                     ║"
            echo "╚════════════════════════════════════════════════════════╝"
            echo ""
            echo "📍 Location: ${VDEV_ROOT}"
            echo "👤 Context: Ahmed Masud"
            echo ""
            echo "🔥 Urgent Items:"
            grep -A 5 "Status.*NOT STARTED\|Status.*IN PROGRESS" ${VDEV_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null | head -10
            echo ""
            echo "📊 Priority Matrix:"
            grep -A 6 "Priority Matrix" ${VDEV_CONTEXTS}/people/ahmed-masud/PRIORITIES.md 2>/dev/null | tail -5
            ;;
        search)
            if [[ -z "$1" ]]; then
                echo "Usage: vdev search <query>"
                return 1
            fi
            echo "🔍 Searching contexts for: $@"
            grep -r "$@" ${VDEV_CONTEXTS}/ 2>/dev/null
            ;;
        update)
            echo "🔄 Updating vdev system..."
            cd ${VDEV_ROOT}
            if [[ -d .git ]]; then
                git pull
                echo "✅ vdev updated successfully"
            else
                echo "⚠️  No git repository found. Manual update required."
            fi
            ;;
        help|--help|-h)
            cat <<EOF
╔════════════════════════════════════════════════════════════════════╗
║                     vdev - Development Context Manager             ║
╚════════════════════════════════════════════════════════════════════╝

USAGE:
  vdev <command> [options]

COMMANDS:
  load <name>          Load a context by name
  me|my|self          View your personal priorities
  urgent              Show urgent items
  week|weekly         Show this week's tasks
  month|monthly       Show next month's plan
  todo|todos          View all TODO items
  edit                Edit your priorities
  contexts|list       List all available contexts
  status              Show vdev status dashboard
  search <query>      Search across all contexts
  update              Update vdev system from git
  help                Show this help message

ALIASES:
  vdev-me             View priorities
  vdev-urgent         Show urgent items
  vdev-week           Show this week's tasks
  vdev-matrix         Show priority matrix
  vdev-todo           View all TODOs
  vdev-load <name>    Load a context
  
  cdvdev              Navigate to vdev directory
  cdnotes             Navigate to dev-notes
  cdme                Navigate to your context directory

EXAMPLES:
  vdev me                        # View your priorities
  vdev urgent                    # Check urgent items
  vdev load denis-krusos         # Load Denis's context
  vdev search "email"            # Search for email references
  vdev-week                      # Quick alias for weekly tasks

LOCATION:
  Root: ${VDEV_ROOT}
  Your Context: ${VDEV_CONTEXTS}/people/ahmed-masud/
  
For more help: cat ${VDEV_ROOT}/QUICK-START.md
EOF
            ;;
        *)
            echo "Unknown command: ${cmd}"
            echo "Run 'vdev help' for usage information"
            return 1
            ;;
    esac
}

# Quick context loader with tab completion
_vdev_load_completion() {
    local contexts=()
    for type in people places things; do
        if [[ -d "${VDEV_CONTEXTS}/${type}" ]]; then
            for ctx in ${VDEV_CONTEXTS}/${type}/*(/); do
                contexts+=($(basename ${ctx}))
            done
        fi
    done
    compadd -a contexts
}

# Register completion if using zsh
if [[ -n "${ZSH_VERSION}" ]]; then
    compdef _vdev_load_completion vdev-load
fi

